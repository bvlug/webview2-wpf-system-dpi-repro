<Window x:Class="WV2DpiRepro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebView2 DPI Repro  —  System-DPI-aware / .NET 4.7.2 / x86"
        Height="720" Width="960" MinHeight="400" MinWidth="600"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Background="#2d2d30" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnToggle"
                        Content="Open WebView2"
                        Click="BtnToggle_Click"
                        Padding="12,4" Margin="0,0,8,0"
                        Background="#0e639c" Foreground="White" BorderThickness="0"/>
                <Button Content="Clear log"
                        Click="BtnClearLog_Click"
                        Padding="8,4"
                        Background="#3e3e42" Foreground="#ccc" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ── WebView2 container ── -->
        <Border x:Name="wvContainer"
                Grid.Row="1"
                BorderBrush="#555" BorderThickness="1"
                Margin="4,4,4,2"
                Background="#1a1a1a"/>

        <!-- ── Diagnostic log ── -->
        <Border Grid.Row="2" Background="#1e1e1e" Margin="4,2,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DIAGNOSTIC LOG" Foreground="#888"
                           FontFamily="Consolas" FontSize="10" Padding="6,3,0,0"/>
                <ScrollViewer x:Name="logScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="logText"
                               Foreground="#4ec9b0"
                               FontFamily="Consolas" FontSize="11"
                               Padding="6,0,6,4"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
